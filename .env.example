# Local development defaults. Copy to .env; match database.ini to these values.
POSTGRES_DB=ecommerce_oltp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
# Stable names reuse the existing project volumes; do not delete them.
POSTGRES_VOLUME_NAME=ecommerce_oltp_pgdata
PGADMIN_VOLUME_NAME=ecommerce_pgadmin_data
